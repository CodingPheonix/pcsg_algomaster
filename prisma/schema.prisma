// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

//////////////////////////////////////////////////////
// 👤 USERS
//////////////////////////////////////////////////////

model users_table {
  id              String            @id @map("_id")
  username        String
  password        String
  email           String            @unique
  role            String            @default("user")
  dateJoined      DateTime          @default(now())

  problem_table   problem_table[]
  set_table       set_table[]
  tutorials_table tutorials_table[]
  user_problem    user_problem?
}

//////////////////////////////////////////////////////
// 📦 SET
//////////////////////////////////////////////////////

model set_table {
  id            String          @id @map("_id")
  name          String
  author_id     String

  problem_table problem_table[]

  users_table   users_table     @relation(fields: [author_id], references: [id])

  @@index([author_id])
}

//////////////////////////////////////////////////////
// 🧠 PROBLEM
//////////////////////////////////////////////////////

model problem_table {
  id                  String               @id @map("_id")
  name                String
  link                String
  difficulty          String               @default("Easy")
  video_link          String?
  author_id           String
  hints               Json?

  problem_description problem_description?
  problem_visuals     problem_visuals?

  users_table         users_table          @relation(fields: [author_id], references: [id])

  set_id    String
  set_table set_table @relation(fields: [set_id], references: [id])

  @@index([author_id])
  @@index([set_id])
}

//////////////////////////////////////////////////////
// 📝 PROBLEM DESCRIPTION
//////////////////////////////////////////////////////

model problem_description {
  id            String        @id @map("_id")
  title         String?
  content       String?

  problem_id    String        @unique
  problem_table problem_table @relation(fields: [problem_id], references: [id])
}

//////////////////////////////////////////////////////
// 🎥 PROBLEM VISUALS
//////////////////////////////////////////////////////

model problem_visuals {
  id            String        @id @map("_id")
  problem_id    String        @unique
  code_text     String
  code_steps    String
  input_array   String

  problem_table problem_table @relation(fields: [problem_id], references: [id])
}

//////////////////////////////////////////////////////
// 👤 USER PROBLEM
//////////////////////////////////////////////////////

model user_problem {
  id          String      @id @map("_id")
  user_id     String      @unique
  problem_ids Json?

  users_table users_table @relation(fields: [user_id], references: [id])
}

//////////////////////////////////////////////////////
// 📚 TUTORIAL
//////////////////////////////////////////////////////

model tutorials_table {
  id       String @id @map("_id")
  title    String
  authorId String
  type     String @default("algorithm")

  subtopic_table subtopic_table[]

  users_table users_table @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

//////////////////////////////////////////////////////
// 🧠 SUBTOPIC
//////////////////////////////////////////////////////

model subtopic_table {
  id             String  @id @map("_id")
  name           String
  description    String?
  difficulty     String  @default("Easy")
  external_video String?

  tutorial_id    String
  tutorial_table tutorials_table @relation(fields: [tutorial_id], references: [id])

  topics_table topics_table[]
  algovisuals_table algovisuals_table[]

  @@index([tutorial_id])
}

//////////////////////////////////////////////////////
// ⚙️ ALGOVISUALS
//////////////////////////////////////////////////////

model algovisuals_table {
  id          String  @id @map("_id")
  subtopic_id String?

  code_text   String
  code_steps  String
  input_array String

  subtopic_table subtopic_table? @relation(fields: [subtopic_id], references: [id])

  @@index([subtopic_id])
}

//////////////////////////////////////////////////////
// 📝 TOPICS
//////////////////////////////////////////////////////

model topics_table {
  id               String  @id @map("_id")
  title            String?
  content          String?

  subtopic_tableId String? @unique

  subtopicTable subtopic_table? @relation(fields: [subtopic_tableId], references: [id])

  comments_table comments_table[]
}

//////////////////////////////////////////////////////
// 💬 COMMENTS
//////////////////////////////////////////////////////

model comments_table {
  id       String    @id @map("_id")
  username String
  message  String
  time     DateTime?

  topic_id String
  topics_table topics_table @relation(fields: [topic_id], references: [id])

  @@index([topic_id])
}