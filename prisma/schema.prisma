// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model users_table {
  id              String            @id @db.VarChar(40)
  username        String            @db.VarChar(255)
  password        String            @db.VarChar(255)
  email           String            @unique(map: "users_table_email_unique") @db.VarChar(255)
  role            String            @default("user") @db.VarChar(50)
  dateJoined      DateTime          @default(dbgenerated("('2026-03-22 05:25:50')")) @db.DateTime(0)
  problem_table   problem_table[]
  set_table       set_table[]
  tutorials_table tutorials_table[]
  user_problem    user_problem?
}

model set_table {
  id            String          @id @db.VarChar(40)
  name          String          @db.VarChar(100)
  author_id     String          @db.VarChar(40)
  // set_problem set_problem[]
  problem_table problem_table[]
  users_table   users_table     @relation(fields: [author_id], references: [id], onUpdate: Restrict, map: "set_table_author_id_users_table_id_fk")

  @@index([author_id], map: "set_table_author_id_users_table_id_fk")
}

model problem_description {
  id            String        @id @db.VarChar(40)
  title         String?       @db.VarChar(255)
  content       String?       @db.LongText
  problem_id    String        @unique(map: "problem_description_problem_id_unique") @db.VarChar(40)
  problem_table problem_table @relation(fields: [problem_id], references: [id], onUpdate: Restrict, map: "problem_description_problem_id_problem_table_id_fk")
}

model problem_table {
  id                  String               @id @db.VarChar(40)
  name                String               @db.VarChar(200)
  link                String               @db.VarChar(1000)
  difficulty          String               @default("Easy") @db.VarChar(10)
  video_link          String?              @db.VarChar(1000)
  author_id           String               @db.VarChar(40)
  hints               Json?                @db.Json
  problem_description problem_description?
  users_table         users_table          @relation(fields: [author_id], references: [id], onUpdate: Restrict, map: "problem_table_author_id_users_table_id_fk")
  problem_visuals     problem_visuals?

  set_id    String    @db.VarChar(40)
  set_table set_table @relation(fields: [set_id], references: [id], onUpdate: Restrict)

  @@index([author_id], map: "problem_table_author_id_users_table_id_fk")
}

model problem_visuals {
  id            String        @id @db.VarChar(40)
  problem_id    String        @unique(map: "problem_visuals_problem_id_unique") @db.VarChar(40)
  code_text     String        @db.VarChar(500)
  code_steps    String        @db.LongText
  input_array   String        @db.VarChar(500)
  problem_table problem_table @relation(fields: [problem_id], references: [id], onUpdate: Restrict, map: "problem_visuals_problem_id_problem_table_id_fk")
}

model user_problem {
  id          String      @id @db.VarChar(40)
  user_id     String      @unique(map: "user_problem_user_id_unique") @db.VarChar(40)
  problem_ids Json?       @db.Json
  users_table users_table @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "user_problem_user_id_users_table_id_fk")
}

model tutorials_table {
  id       String @id @db.VarChar(40)
  title    String @db.VarChar(255)
  authorId String @db.VarChar(255)
  type     String @default("algorithm") @db.VarChar(20)

  // tutorial_subtopics tutorial_subtopics[] 
  subtopic_table subtopic_table[]
  users_table    users_table      @relation(fields: [authorId], references: [id], onUpdate: Restrict, map: "tutorials_table_authorId_users_table_id_fk")
  // topicsTables   topics_table[]

  @@index([authorId], map: "tutorials_table_authorId_users_table_id_fk")
}

model subtopic_table {
  id             String  @id @db.VarChar(40)
  name           String  @db.VarChar(255)
  description    String? @db.VarChar(255)
  difficulty     String  @default("Easy") @db.VarChar(255)
  external_video String? @db.VarChar(1000)

  topics_table topics_table[]

  tutorial_id    String          @db.VarChar(40)
  tutorial_table tutorials_table @relation(fields: [tutorial_id], references: [id], onUpdate: Restrict)

  algovisuals_table algovisuals_table[]

  @@index([tutorial_id])
}

model algovisuals_table {
  id             String          @id @db.VarChar(40)
  subtopic_id    String?         @db.VarChar(40)
  code_text      String          @db.LongText
  code_steps     String          @db.LongText
  input_array    String          @db.VarChar(30)
  subtopic_table subtopic_table? @relation(fields: [subtopic_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "algovisuals_table_subtopic_id_subtopic_table_id_fk")

  @@index([subtopic_id], map: "algovisuals_table_subtopic_id_subtopic_table_id_fk")
}

model topics_table {
  id               String  @id @db.VarChar(40)
  title            String? @db.VarChar(255)
  content          String? @db.LongText
  subtopic_tableId String? @unique @db.VarChar(40)

  comments_table comments_table[]

  subtopicTable subtopic_table? @relation(fields: [subtopic_tableId], references: [id], map: "subtopic_tableId_topics_table_id_fk")

  @@index([subtopic_tableId], map: "subtopic_tableId_topics_table_id_fk")
}

model comments_table {
  id           String       @id @db.VarChar(40)
  username     String       @db.VarChar(100)
  message      String       @db.VarChar(500)
  time         DateTime?    @db.Date
  topic_id     String       @db.VarChar(40)
  topics_table topics_table @relation(fields: [topic_id], references: [id], onUpdate: Restrict, map: "comments_table_topic_id_topics_table_id_fk")

  @@index([topic_id], map: "comments_table_topic_id_topics_table_id_fk")
}
